{
  "name": "portfolio-page",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "dependencies": {
    "@material-ui/core": "latest",
    "@material-ui/icons": "latest",
    "cors": "^2.8.5",
    "dotenv-webpack": "1.5.7",
    "express": "^4.16.4",
    "express-validator": "^5.3.1",
    "isomorphic-unfetch": "^3.0.0",
    "jss": "^10.0.0-alpha.14",
    "next": "latest",
    "nodemailer": "^6.1.1",
    "react": "latest",
    "react-dom": "latest",
    "react-google-recaptcha": "^1.0.5",
    "react-jss": "^8.1.0",
    "react-scripts": "^3.0.0",
    "request": "^2.88.0",
    "sharp": "^0.22.0",
    "styled-jsx": "^3.2.1"
  },
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "prepare": "husky"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "devDependencies": {
    "dotenv": "^6.2.0",
    "@biomejs/biome": "^1.9.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  },
  "babel": {
    "presets": [
      "next/babel"
    ],
    "plugins": [
      "styled-jsx/babel"
    ]
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
